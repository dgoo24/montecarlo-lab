# Copy to .env and adjust for your machine.
MC_DATABASE_URL=postgresql+psycopg://montecarlo:montecarlo@localhost:5432/montecarlo
MC_ENVIRONMENT=local
MC_LOG_LEVEL=INFO

# Workload guards
MC_MAX_PATHS=20000
MC_MAX_STEPS=5000
MC_MAX_CELLS=2500000

# ETL guards
MC_MAX_UPLOAD_BYTES=10485760
MC_MAX_DATASET_ROWS=200000
